{
  "id": "/app",
  "name": "System Formy",
  "short_name": "System Formy",
  "description": "Plany treningowe, treningi, postępy i wyzwania w jednej aplikacji.",
  "start_url": "/app",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "orientation": "portrait-primary",
  "background_color": "#10110f",
  "theme_color": "#10110f",
  "icons": [
    {
      "src": "/pwa-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/pwa-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Rozpocznij trening",
      "short_name": "Trening",
      "description": "Otwórz treningi w Systemie Formy",
      "url": "/app/trening",
      "icons": [
        {
          "src": "/pwa-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Moje postępy",
      "short_name": "Postępy",
      "description": "Sprawdź historię treningów i postępy",
      "url": "/app/postepy",
      "icons": [
        {
          "src": "/pwa-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ]
}
