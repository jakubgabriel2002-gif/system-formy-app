{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "system-formy-app",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-20",
  "vars": {
    "ADMIN_EMAIL": "jakub.gabriel2002@gmail.com"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ],
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "system-formy-db",
      "database_id": "4acf90b9-93af-4cf2-aeef-cbe0fd4406d1",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PRODUCT_FILES",
      "bucket_name": "system-formy-products"
    }
  ]
}
